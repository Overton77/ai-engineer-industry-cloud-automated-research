{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiengineer.local/contracts/ingestion-intent.schema.json",
  "title": "AI Engineer deterministic ingestion intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent_type", "idempotency_key", "payload", "preconditions"],
  "properties": {
    "schema_version": { "const": "ai-engineer-ingestion-intent/1" },
    "intent_type": {
      "enum": ["upsert_entity", "link_entities", "record_claim", "record_metric_observations", "ingest_research_bundle", "publish_report"]
    },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 240, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "video_id": { "type": ["string", "null"] },
    "mission_id": { "type": ["string", "null"], "format": "uuid" },
    "attempt_id": { "type": ["string", "null"], "format": "uuid" },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "preconditions": { "type": "object" },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["operations"],
      "properties": {
        "source_report": {
          "type": ["object", "null"],
          "properties": {
            "bucket": { "const": "ai-engineer-cloud-bucket" },
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "required": ["bucket", "path", "sha256"]
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "action", "target", "values"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
              "action": { "enum": ["insert", "upsert"] },
              "target": { "type": "string", "pattern": "^(corpus|staging|evidence|ranking|research|taxonomy)\\.[a-z][a-z0-9_]*$" },
              "values": { "type": "object", "minProperties": 1 },
              "conflict_columns": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
              },
              "returning": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
            },
            "allOf": [
              {
                "if": { "properties": { "action": { "const": "upsert" } } },
                "then": {
                  "properties": { "conflict_columns": { "type": "array" } },
                  "required": ["conflict_columns"]
                }
              }
            ]
          }
        }
      }
    }
  }
}
