# Required for authenticated research runs. Add real values in Cursor Secrets,
# never in this file.
TAVILY_API_KEY=tvly-your-key
FIRECRAWL_API_KEY=fc-your-key

# Optional: disable Firecrawl's automatic endpoint/search feedback.
# FIRECRAWL_NO_ENDPOINT_FEEDBACK=1
# FIRECRAWL_NO_SEARCH_FEEDBACK=1

# Optional and only needed when your MCP definitions reference these names.
# GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_your-token
# CONTEXT7_API_KEY=ctx7-your-key
#
# This Cloud environment does not connect to the research-starter Postgres
# database. Query Google Drive catalogs and db_inspection.md files instead.
