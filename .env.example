# Required for authenticated research runs. Add real values in Cursor Secrets,
# never in this file.
TAVILY_API_KEY=tvly-your-key
FIRECRAWL_API_KEY=fc-your-key

# Required at runtime for catalog / pre-research / ingestion tables.
POSTGRES_URL_NON_POOLING=postgresql://postgres.project-ref:password@host:5432/postgres
# Preferred: pin the provider CA, preserving newlines as \\n in Cursor Secrets.
# POSTGRES_SSL_ROOT_CERT=-----BEGIN CERTIFICATE-----\\n...\\n-----END CERTIFICATE-----
# Last resort for a known self-signed development endpoint only:
# POSTGRES_SSL_MODE=no-verify
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
# Legacy fallback only: SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# Optional: disable Firecrawl's automatic endpoint/search feedback.
# FIRECRAWL_NO_ENDPOINT_FEEDBACK=1
# FIRECRAWL_NO_SEARCH_FEEDBACK=1

# Optional and only needed when your MCP definitions reference these names.
# GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_your-token
# CONTEXT7_API_KEY=ctx7-your-key
